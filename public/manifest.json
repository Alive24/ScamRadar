{
  "manifest_version": 3,
  "name": "ScamRadar",
  "version": "0.1.0",
  "description": "Real-time triage and case capture for suspicious outreach.",
  "action": {
    "default_title": "ScamRadar",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
